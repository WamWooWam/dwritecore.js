{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "ES2023",
      "ESNext.Disposable",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "preserveConstEnums": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}